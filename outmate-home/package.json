{
  "name": "outmate-home",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/visual/responsive.mjs",
    "api": "node server/mock-api.mjs",
    "test": "npm run test:api && npm run test:grid",
    "test:api": "node --test server/mock-api.test.mjs",
    "test:grid": "node --test scripts/grid.test.mjs",
    "test:grid:e2e": "node scripts/visual/grid.mjs"
  },
  "dependencies": {
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.6.1",
    "postcss": "8.5.31",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.3",
    "vite": "6.4.5"
  }
}
